  "pages": [
    {
      "text": "Ned spots a big wheel near the pond.",
      "illustration": "Ned the duckling noticing a big wooden water wheel beside the pond."
    },
    {
      "text": "The wheel spins and spins.",
      "illustration": "The wooden water wheel turning steadily in the flowing water."
    },
    {
      "text": "Ned wants a go.",
      "illustration": "Ned the duckling eyeing the turning wheel, keen to try it."
    },
    {
      "text": "Ned sits on the wheel.",
      "illustration": "Ned the duckling climbing onto one of the wheel's wide paddles."
    },
    {
      "text": "The wheel spins Ned round.",
      "illustration": "Ned the duckling being carried round and round as the wheel turns."
    },
    {
      "text": "Ned is not well.",
      "illustration": "Ned the duckling looking a little dizzy and unsteady."
    },
    {
      "text": "Ned hops off the wheel.",
      "illustration": "Ned the duckling hopping quickly off the turning wheel onto the bank."
    },
    {
      "text": "Ned sits still on the bank.",
      "illustration": "Ned the duckling sitting very still on the grassy bank, steadying himself."
    },
    {
      "text": "The wheel spins without Ned.",
      "illustration": "The water wheel continuing to turn on its own in the flowing water."
    },
    {
      "text": "Ned claps for the big wheel.",
