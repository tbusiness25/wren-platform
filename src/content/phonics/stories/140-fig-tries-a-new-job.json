    },
    {
      "text": "Fig sets a leaf on the shelf.",
      "illustration": "Fig the caterpillar arranging small leaves neatly along the ledge."
    },
    {
      "text": "Fig feels like a snack.",
      "illustration": "Fig the caterpillar pausing beside the leaves, looking tempted."
    },
    {
      "text": "Fig has one leaf.",
      "illustration": "Fig the caterpillar nibbling the edge of one leaf."
    },
    {
      "text": "Fig keeps on, leaf after leaf.",
      "illustration": "Fig the caterpillar nibbling through several leaves in a row."
    },
