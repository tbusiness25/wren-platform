  "pages": [
    {
      "text": "Fig sees Nell fix up the plant box.",
      "illustration": "Fig the caterpillar watching Nell the bee tidying a row of plants in a window box."
    },
    {
      "text": "Fig wants to help too.",
      "illustration": "Fig the caterpillar crawling closer to the plant box, keen to help."
    },
    {
      "text": "Fig tries a new job.",
